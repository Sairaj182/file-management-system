{
  "name": "file-management-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -- turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:whitebox": "turbo run test:whitebox --filter=api",
    "test:blackbox": "dotenv -e .env.test.local -- turbo run test:blackbox --filter=api",
    "test:integration": "dotenv -e .env.test.local -- turbo run test:integration --filter=api",
    "test:acceptance": "dotenv -e .env.test.local -- pnpm --filter web run test:acceptance",
    "test:usability": "dotenv -e .env.test.local -- pnpm --filter web run test:usability",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:studio": "dotenv -- pnpm --filter @repo/database exec prisma studio",
    "db:generate": "dotenv -- pnpm --filter @repo/database exec prisma generate",
    "db:migrate:dev": "dotenv -- pnpm --filter @repo/database exec prisma migrate dev",
    "db:migrate:deploy": "dotenv -- pnpm --filter @repo/database exec prisma migrate deploy",
    "db:status": "dotenv -- pnpm --filter @repo/database run db:status",
    "db:seed": "dotenv -- pnpm --filter @repo/database exec tsx prisma/seed/index.ts",
    "db:bootstrap": "pnpm db:seed",
    "storage:smoke": "pnpm --filter api run storage:smoke",
    "storage:reconcile": "pnpm --filter api run storage:reconcile"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.14",
    "typescript": "5.9.2",
    "yaml": "2.4.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
