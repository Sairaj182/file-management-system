// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Better auth tables

model User {
  id                  String          @id
  name                String?
  email               String?         @unique
  emailVerified       Boolean         @default(false)
  phoneNumber         String?         @unique
  phoneNumberVerified Boolean         @default(false)
  image               String?
  banned              Boolean         @default(false)
  bannedAt            DateTime?
  bannedReason        String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  sessions            Session[]
  accounts            Account[]
  trustedDevices      TrustedDevice[]
  roles               UserRole[]

  createdDockyards Dockyards[] @relation("DockyardCreatedBy")
  createdApis      Api[] @relation("ApiCreatedBy")
  dockyardMemberships DockyardMember[] @relation("DockyardMembershipUser")
  addedDockyardMembers DockyardMember[] @relation("DockyardMemberAddedBy")
  uploadedDockyardFiles DockyardFile[] @relation("DockyardFileUploader")
  dockyardAuditEvents DockyardAuditEvent[] @relation("DockyardAuditActor")
  targetedDockyardAuditEvents DockyardAuditEvent[] @relation("DockyardAuditTarget")
  
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  issuer                String?
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}


model TrustedDevice {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashedToken     String    @unique
  fingerprintHash String
  deviceName      String?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// RBAC

enum PermissionScope {
  own
  any
}

model Permission {
  id          String          @id @default(cuid())
  resource    String
  action      String
  scope       PermissionScope
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@unique([resource, action, scope])
  @@index([resource])
  @@index([action])
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model AccountRecoveryRequest {
  id           String   @id @default(cuid())
  phoneNumber  String
  status       String   @default("PENDING")
  requestCount Int      @default(1)
  windowStart  DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([phoneNumber])
  @@index([windowStart])
}

model OtpCooldown {
  phoneNumber String   @id
  expiresAt   DateTime
}


// DOCKYARD

enum DockStatus{
  ACTIVE
  INACTIVE
  INCUSTODY
  SUSPENDED
}

enum DockyardMemberRole {
  OWNER
  MANAGER
  VIEWER
}

enum ApiKeyScope {
  FILE_READ
  FILE_WRITE
  FILE_DELETE
}

enum FileLifecycleState {
  STAGED
  AVAILABLE
  QUARANTINED
  DELETING
  DELETED
  FAILED
}

model Dockyards {
  id String @id @default(cuid())
  status DockStatus
  notes String

  apiKeys Api[] 
  members DockyardMember[]
  files DockyardFile[]
  auditEvents DockyardAuditEvent[]

  
  createdById String
  createdBy User @relation("DockyardCreatedBy",fields:[createdById], references:[id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// one dockyard can have n api keys
model Api {
  id String @id @default(cuid())  
  dockId String
  dockyard Dockyards @relation(fields:[dockId],references:[id], onDelete: Restrict)

  createdById String
  createdBy User @relation("ApiCreatedBy",fields:[createdById], references:[id], onDelete: Restrict)

  name String?
  keyPrefix String? @unique
  keyDigest String? @unique
  scopes ApiKeyScope[] @default([])
  expiresAt DateTime?
  revokedAt DateTime?
  lastUsedAt DateTime?

  createdAt DateTime @default(now())

  @@index([dockId, revokedAt])
  @@index([expiresAt])
}

model DockyardMember {
  id String @id @default(cuid())
  dockyardId String
  userId String
  role DockyardMemberRole
  addedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dockyard Dockyards @relation(fields: [dockyardId], references: [id], onDelete: Restrict)
  user User @relation("DockyardMembershipUser", fields: [userId], references: [id], onDelete: Restrict)
  addedBy User? @relation("DockyardMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([dockyardId, userId])
  @@index([userId, dockyardId])
  @@index([dockyardId, role])
}

model DockyardFile {
  id String @id @default(cuid())
  dockyardId String
  uploadedById String?
  storageKey String @unique
  originalName String
  contentType String
  sizeBytes BigInt
  sha256 String?
  state FileLifecycleState @default(STAGED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  dockyard Dockyards @relation(fields: [dockyardId], references: [id], onDelete: Restrict)
  uploadedBy User? @relation("DockyardFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([dockyardId, state, createdAt])
  @@index([uploadedById])
}

model DockyardAuditEvent {
  id String @id @default(cuid())
  dockyardId String
  actorUserId String?
  targetUserId String?
  action String
  metadata Json?
  createdAt DateTime @default(now())

  dockyard Dockyards @relation(fields: [dockyardId], references: [id], onDelete: Restrict)
  actor User? @relation("DockyardAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("DockyardAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([dockyardId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId])
}
